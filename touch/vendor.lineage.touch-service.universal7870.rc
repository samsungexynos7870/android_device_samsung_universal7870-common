on early-init
    chown system radio /sys/class/sec/tsp/cmd
    chmod 0664 /sys/class/sec/tsp/cmd
    chown system system /sys/class/sec/sec_touchkey/input/enabled
    chmod 0664 /sys/class/sec/sec_touchkey/input/enabled

service vendor.touch-hal /vendor/bin/hw/vendor.lineage.touch-service.universal7870
    class hal
    user system
    group system
    interface aidl vendor.lineage.touch.IHighTouchPollingRate/default
    interface aidl vendor.lineage.touch.IKeyDisabler/default
