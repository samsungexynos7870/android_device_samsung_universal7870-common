cc_binary {
    name: "vendor.lineage.touch-service.universal7870",
    init_rc: ["vendor.lineage.touch-service.universal7870.rc"],
    relative_install_path: "hw",
    vendor: true,
    srcs: [
        "HighTouchPollingRate.cpp",
        "KeyDisabler.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
        "vendor.lineage.touch-V1-ndk",
    ],
}
