<!-- Ported AIDL wifi HAL (module android.hardware.wifi-service-legacy).
     The hal name, version and fqname are fixed by the framework - only the
     file name carries the -legacy suffix. -->
<manifest version="1.0" type="device">
	<hal format="aidl">
		<name>android.hardware.wifi</name>
		<version>3</version>
		<fqname>IWifi/default</fqname>
	</hal>
</manifest>
