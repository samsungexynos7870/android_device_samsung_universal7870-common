// Ported into the device tree from AOSP/LineageOS hardware/interfaces so that the
// legacy-shim wifi HAL survives upstream churn and can be patched locally.
//
//   source : hardware/interfaces/wifi/aidl/default @ lineage-22.2
//            commit 89252f8fa9f56b373581beee2ca0ffe19bfdcd93 (2026-06-01)
//   tree   : device/samsung/universal7870-common/hardware/wifi/aidl/default
//
// Renames (the installed *files* keep their standard names - see the stem:
// properties and the rc/xml names - because system/sepolicy/vendor/file_contexts
// labels exactly those paths and hal_wifi_default_exec is private policy that a
// device tree cannot reference):
//
//   upstream module                                 module here
//   wifi_hal_cc_defaults                         -> wifi_hal_legacy_cc_defaults
//   ...wifi-service-cppflags-defaults            -> ...wifi-service-legacy-cppflags-defaults
//   ...wifi-service-lib                          -> ...wifi-service-legacy-lib
//   ...wifi-service                              -> ...wifi-service-legacy       (stem: ...wifi-service)
//   ...wifi-service-lazy                         -> ...wifi-service-legacy-lazy  (stem: ...wifi-service-lazy)
//   ...wifi-service.xml_vintf                    -> ...wifi-service-legacy.xml_vintf
//   ...wifi-service-tests                        -> ...wifi-service-legacy-tests
//
// The rc/vintf files follow the same scheme (they were *renamed*, not rewritten):
//   android.hardware.wifi-service.rc       -> android.hardware.wifi-service-legacy.rc
//   android.hardware.wifi-service-lazy.rc  -> android.hardware.wifi-service-legacy-lazy.rc
//   android.hardware.wifi-service.xml      -> android.hardware.wifi-service-legacy.xml
// Their *contents* (service name, interface, hal name/version/fqname) are unchanged.
//
// Added on top of upstream: header_libs/export_header_lib_headers =
// wifi_legacy_headers, so the HAL always compiles against the maintained
// wifi_hal.h generation the vendor libwifi-hal.so uses (a stale generation
// shifts wifi_hal_fn index 106 to wifi_virtual_interface_delete -> SIGSEGV in
// configureChip()); and a local license module, because
// hardware_interfaces_license is package-scoped to hardware/interfaces.
// The AIDL *interface* (android.hardware.wifi-V3-ndk) still comes from upstream
// hardware/interfaces - only the implementation is vendored here.

//
// Licensed under the Apache License, Version 2.0 (the "License");
// you may not use this file except in compliance with the License.
// You may obtain a copy of the License at
//
//      http://www.apache.org/licenses/LICENSE-2.0
//
// Unless required by applicable law or agreed to in writing, software
// distributed under the License is distributed on an "AS IS" BASIS,
// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
// See the License for the specific language governing permissions and
// limitations under the License.

package {
    default_applicable_licenses: ["device_samsung_universal7870_wifi_legacy_license"],
}

// hardware_interfaces_license is package-scoped to hardware/interfaces, so a
// device-tree import needs its own license module.
license {
    name: "device_samsung_universal7870_wifi_legacy_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["NOTICE"],
}

soong_config_module_type {
    name: "wifi_hal_legacy_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "wifi",
    bool_variables: [
        "hidl_feature_aware", // WIFI_HIDL_FEATURE_AWARE
        "hidl_feature_dual_interface", // WIFI_HIDL_FEATURE_DUAL_INTERFACE
        "hidl_feature_disable_ap", // WIFI_HIDL_FEATURE_DISABLE_AP
        "hidl_feature_disable_ap_mac_randomization", // WIFI_HIDL_FEATURE_DISABLE_AP_MAC_RANDOMIZATION
        "avoid_iface_reset_mac_change", // WIFI_AVOID_IFACE_RESET_MAC_CHANGE
        "wifi_skip_state_toggle_off_on_for_nan", // WIFI_SKIP_STATE_TOGGLE_OFF_ON_FOR_NAN
    ],
    value_variables: [
        "hal_interface_combinations", // WIFI_HAL_INTERFACE_COMBINATIONS
    ],
    properties: [
        "cppflags",
    ],
}

wifi_hal_legacy_cc_defaults {
    name: "android.hardware.wifi-service-legacy-cppflags-defaults",
    soong_config_variables: {
        hidl_feature_aware: {
            cppflags: ["-DWIFI_HIDL_FEATURE_AWARE"],
        },
        hidl_feature_dual_interface: {
            cppflags: ["-DWIFI_HIDL_FEATURE_DUAL_INTERFACE"],
        },
        hidl_feature_disable_ap: {
            cppflags: ["-DWIFI_HIDL_FEATURE_DISABLE_AP"],
        },
        hidl_feature_disable_ap_mac_randomization: {
            cppflags: ["-DWIFI_HIDL_FEATURE_DISABLE_AP_MAC_RANDOMIZATION"],
        },
        avoid_iface_reset_mac_change: {
            cppflags: ["-DWIFI_AVOID_IFACE_RESET_MAC_CHANGE"],
        },
        wifi_skip_state_toggle_off_on_for_nan: {
            cppflags: ["-DWIFI_SKIP_STATE_TOGGLE_OFF_ON_FOR_NAN"],
        },
        hal_interface_combinations: {
            cppflags: ["-DWIFI_HAL_INTERFACE_COMBINATIONS=%s"],
        },
    },
}

cc_library_static {
    name: "android.hardware.wifi-service-legacy-lib",
    defaults: ["android.hardware.wifi-service-legacy-cppflags-defaults"],
    proprietary: true,
    compile_multilib: "first",
    cppflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
    // Allow implicit fallthroughs in wifi_legacy_hal.cpp until they are fixed.
    cflags: ["-Wno-error=implicit-fallthrough"],
    srcs: [
        "aidl_struct_util.cpp",
        "aidl_sync_util.cpp",
        "ringbuffer.cpp",
        "wifi.cpp",
        "wifi_ap_iface.cpp",
        "wifi_chip.cpp",
        "wifi_feature_flags.cpp",
        "wifi_iface_util.cpp",
        "wifi_legacy_hal.cpp",
        "wifi_legacy_hal_factory.cpp",
        "wifi_legacy_hal_stubs.cpp",
        "wifi_mode_controller.cpp",
        "wifi_nan_iface.cpp",
        "wifi_p2p_iface.cpp",
        "wifi_rtt_controller.cpp",
        "wifi_sta_iface.cpp",
        "wifi_status_util.cpp",
    ],

    // wifi_legacy_hal.h includes <hardware_legacy/wifi_hal.h>; pin the header
    // library explicitly so this HAL can only build against the maintained
    // generation in wifi/legacy_headers - the same one the vendor
    // libwifi-hal.so is built with (header_libs: ["wifi_legacy_headers"] in
    // android_hardware_qcom_wlan legacy/qcwcn/wifi_hal/Android.bp).
    header_libs: ["wifi_legacy_headers"],
    export_header_lib_headers: ["wifi_legacy_headers"],

    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "liblog",
        "libnl",
        "libutils",
        "libwifi-hal",
        "libwifi-system-iface",
        "libxml2",
        "android.hardware.wifi-V3-ndk",
    ],

    export_include_dirs: ["."],
}

cc_binary {
    name: "android.hardware.wifi-service-legacy",
    // Installed as /vendor/bin/hw/android.hardware.wifi-service on purpose: that
    // path is labelled hal_wifi_default_exec by
    // system/sepolicy/vendor/file_contexts, and hal_wifi_default_exec lives in
    // *private* policy, so a device tree cannot label a differently named
    // binary with it. Only the Soong module name carries the -legacy suffix.
    stem: "android.hardware.wifi-service",
    relative_install_path: "hw",
    proprietary: true,
    cppflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
    srcs: ["service.cpp"],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "liblog",
        "libnl",
        "libutils",
        "libwifi-hal",
        "libwifi-system-iface",
        "libxml2",
        "android.hardware.wifi-V3-ndk",
    ],
    static_libs: ["android.hardware.wifi-service-legacy-lib"],
    init_rc: ["android.hardware.wifi-service-legacy.rc"],
    // No vintf_fragment_modules on purpose - the manifest entry comes from
    // upstream's android.hardware.wifi-service.xml_vintf (see the header).
}

cc_binary {
    name: "android.hardware.wifi-service-legacy-lazy",
    overrides: ["android.hardware.wifi-service-legacy"],
    // same reasoning as the non-lazy variant
    stem: "android.hardware.wifi-service-lazy",
    cflags: ["-DLAZY_SERVICE"],
    relative_install_path: "hw",
    proprietary: true,
    cppflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
    srcs: ["service.cpp"],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "liblog",
        "libnl",
        "libutils",
        "libwifi-hal",
        "libwifi-system-iface",
        "libxml2",
        "android.hardware.wifi-V3-ndk",
    ],
    static_libs: ["android.hardware.wifi-service-legacy-lib"],
    init_rc: ["android.hardware.wifi-service-legacy-lazy.rc"],
    // No vintf_fragment_modules - same reason as the non-lazy binary above.
}

cc_test {
    name: "android.hardware.wifi-service-legacy-tests",
    proprietary: true,
    compile_multilib: "first",
    cppflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
    srcs: [
        "tests/aidl_struct_util_unit_tests.cpp",
        "tests/main.cpp",
        "tests/mock_interface_tool.cpp",
        "tests/mock_wifi_feature_flags.cpp",
        "tests/mock_wifi_iface_util.cpp",
        "tests/mock_wifi_legacy_hal.cpp",
        "tests/mock_wifi_mode_controller.cpp",
        "tests/ringbuffer_unit_tests.cpp",
        "tests/wifi_nan_iface_unit_tests.cpp",
        "tests/wifi_chip_unit_tests.cpp",
        "tests/wifi_iface_util_unit_tests.cpp",
    ],
    static_libs: [
        "libgmock",
        "libgtest",
        "android.hardware.wifi-V3-ndk",
        "android.hardware.wifi.common-V2-ndk",
        "android.hardware.wifi-service-legacy-lib",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "liblog",
        "libnl",
        "libutils",
        "libwifi-hal",
        "libwifi-system-iface",
    ],
}

filegroup {
    name: "default-android.hardware.wifi-service-legacy.rc",
    srcs: ["android.hardware.wifi-service-legacy.rc"],
}

filegroup {
    name: "default-android.hardware.wifi-service-legacy-lazy.rc",
    srcs: ["android.hardware.wifi-service-legacy-lazy.rc"],
}
